DATABASE_URL=sqlite:///data/sismocol.sqlite3
NEWS_URLS=
# Si se fija, sync-events usa este rango; si se deja vacío, consulta los últimos SISMOCOL_SYNC_DAYS días.
SISMOCOL_START_DATE=
SISMOCOL_END_DATE=
SISMOCOL_SYNC_DAYS=7
# Sismos generales con magnitud menor no se guardan (las réplicas del terremoto se guardan siempre).
SISMOCOL_MIN_MAGNITUDE=2.5
# Meses de detalle que se conservan para sismos no asociados al terremoto.
SISMOCOL_RETENTION_MONTHS=24
REQUEST_TIMEOUT=20
